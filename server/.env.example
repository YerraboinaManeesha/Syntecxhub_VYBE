# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# Exact origin of the frontend (no trailing slash).
# Local: http://localhost:5173   Production: https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string.
# Local MongoDB:  mongodb://127.0.0.1:27017/vybe
# Atlas:          mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/vybe?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/vybe

# Long random string, at least 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cookie SameSite policy: lax | strict | none
#  - lax (default): use when the browser sees API and app as the same site
#    (local dev via the Vite proxy, or production via the Vercel /api rewrite).
#  - none: only if the browser calls the API origin directly cross-site. Requires HTTPS,
#    and many browsers block these third-party cookies, so prefer the rewrite setup.
COOKIE_SAMESITE=lax
