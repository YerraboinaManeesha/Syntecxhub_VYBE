# Copy this file to .env. Only VITE_ variables reach the browser, so never put secrets here.

# --- Local development ---
# Leave both empty. The Vite dev server proxies /api and /socket.io to http://localhost:5000
# (override the proxy target with VITE_DEV_BACKEND if your backend runs elsewhere).
VITE_API_URL=
VITE_SOCKET_URL=

# --- Production (set these in the Vercel project settings, not in this file) ---
# VITE_API_URL      leave EMPTY. API calls go to /api on the Vercel domain, which vercel.json
#                   rewrites to your Render backend. That keeps the session cookie first-party.
# VITE_SOCKET_URL   your Render backend URL, e.g. https://vybe-api.onrender.com
#                   (WebSockets cannot go through Vercel rewrites, so the socket connects directly.
#                   It authenticates with a short-lived token, not the cookie.)
